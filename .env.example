# pg-backup configuration.
#
# Copy to .env and edit. Every setting is read from the environment; this file
# is only a convenient way to populate it.
#
#   docker compose:  referenced automatically via env_file
#   ad-hoc CLI:      ./pg-backup --env-file .env -once
#   plain shell:     set -a && source .env && set +a
#
# Variables already set in the environment always win over this file.

# ---------------------------------------------------------------------------
# Database (standard libpq variables)
# ---------------------------------------------------------------------------

# Required.
PGHOST=localhost
PGUSER=postgres

# Optional. Defaults: PGPORT=5432, PGSSLMODE=prefer.
PGPORT=5432
PGPASSWORD=postgres
# disable | allow | prefer | require | verify-ca | verify-full
PGSSLMODE=prefer

# Comma-separated list of databases to back up.
# Leave empty (or omit) to discover and back up every non-template database.
PG_BACKUP_DATABASES=app_production,app_staging,analytics

# ---------------------------------------------------------------------------
# Storage: local
# ---------------------------------------------------------------------------

# Required. "local" or "s3".
PG_BACKUP_STORAGE_TYPE=local

# Required when PG_BACKUP_STORAGE_TYPE=local.
PG_BACKUP_LOCAL_PATH=./backups

# ---------------------------------------------------------------------------
# Storage: S3 (and S3-compatible providers)
# ---------------------------------------------------------------------------
# Uncomment this block and set PG_BACKUP_STORAGE_TYPE=s3 to use it.
#
# PG_BACKUP_S3_BUCKET=my-db-backups
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# Leave the endpoint unset for AWS S3. For MinIO, R2, Spaces, Arvan, etc. set
# it here; a bare host is fine, https:// is assumed when no scheme is given.
# PG_BACKUP_S3_ENDPOINT=s3.example.com

# ---------------------------------------------------------------------------
# Schedule and behaviour
# ---------------------------------------------------------------------------

# Required. Standard cron, or @daily / @hourly / @every 6h.
PG_BACKUP_SCHEDULE=0 2 * * *

# Optional. Logs ALWAYS go to stderr, so `docker logs` / journald work with no
# configuration at all. Set this only if you additionally want a log file; in a
# container that also needs a writable mount at the same path.
# PG_BACKUP_LOG_FILE=./backup.log

# Run a backup immediately at startup instead of waiting for the schedule.
PG_BACKUP_RUN_ON_START=true

# Delete backups older than this after each successful run. 0 disables pruning.
PG_BACKUP_RETENTION_DAYS=30

# Single file for the whole cluster via pg_dumpall, including roles and
# tablespaces. When true, PG_BACKUP_DATABASES is ignored.
PG_BACKUP_FULL_DUMP=false

# gzip level: -1 default, 0 none, 1 fastest .. 9 smallest. Omit for the default.
# PG_BACKUP_COMPRESSION_LEVEL=-1

# ---------------------------------------------------------------------------
# Health / trigger endpoint
# ---------------------------------------------------------------------------

PG_BACKUP_HEALTH_PORT=8080

# Empty binds all interfaces; 127.0.0.1 restricts to loopback.
PG_BACKUP_HEALTH_BIND=

# Bearer token required by POST /trigger. Strongly recommended whenever the
# health port is reachable from outside the host.
PG_BACKUP_TRIGGER_TOKEN=
